    "prepare": "vp hooks enable"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/bun": "1.4.2",
    "@types/node": "24.13.3",
    "@xstools-dev/cli-toolkit": "0.3.0",
    "@xstools-dev/config-ts": "0.2.0",
    "typescript": "5.8.3",
    "vite-plus": "0.3.2"
  },
  "packageManager": "pnpm@12.4.1"
}
