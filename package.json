{
  "name": "mono",
  "private": true,
  "license": "MIT",
  "scripts": {
    "check": "vp check",
    "check-mono": "sherif",
    "check-publish": "pnpm run build && pnpm run check",
    "clean": "del **/dist **/.build **/.swc **/node_modules !node_modules",
